<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
 <persistence-unit name="tarea3" transaction-type="RESOURCE_LOCAL">
  <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
  <class>epn.edu.ec.model.Estudiante</class>
  <class>epn.edu.ec.model.CuentaUsuario</class>
  <class>epn.edu.ec.model.SesionEstudio</class>
  <class>epn.edu.ec.model.BloquePomodoro</class>
  <class>epn.edu.ec.model.ConfiguracionPomodoro</class>
  <class>epn.edu.ec.model.SesionCompartida</class>
  <class>epn.edu.ec.model.ParticipacionCompartida</class>
  <exclude-unlisted-classes>true</exclude-unlisted-classes>
  <properties>
   <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
   <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/pomora"/>
   <property name="jakarta.persistence.jdbc.user" value="sa"/>
   <property name="jakarta.persistence.jdbc.password" value=""/>
   <property name="hibernate.hbm2ddl.auto" value="update"/>
   <property name="hibernate.show_sql" value="true"/>
  </properties>
 </persistence-unit>
</persistence>
